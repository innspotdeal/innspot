# رابط قاعدة بيانات Postgres (من Vercel Postgres/Neon أو أي مزوّد تاني)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# مفاتيح الـ ERP — هو لوحة التحكم الوحيدة (مفيش /admin على الموقع)
# الصيغة: "اسم:مفتاح" مفصولين بفاصلة، والمفتاح 32 حرف على الأقل (راجع docs/ERP-API.md)
ERP_API_KEYS="erp-prod:change-me-to-a-long-random-key-of-32-chars-or-more"

# رمز رفع الصور (Vercel Blob) — بيتضاف تلقائيًا لما تفعّل Blob storage من
# Vercel Dashboard → Storage → Create Database → Blob، مش محتاج تكتبه يدويًا
BLOB_READ_WRITE_TOKEN=""
