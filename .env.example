# رابط قاعدة بيانات Postgres (من Vercel Postgres/Neon أو أي مزوّد تاني)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# بيانات دخول لوحة الأدمن (/admin/login)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# مفتاح سري عشوائي لتوقيع جلسة الأدمن — أي نص طويل عشوائي
SESSION_SECRET="change-me-to-a-long-random-string"

# رمز رفع الصور (Vercel Blob) — بيتضاف تلقائيًا لما تفعّل Blob storage من
# Vercel Dashboard → Storage → Create Database → Blob، مش محتاج تكتبه يدويًا
BLOB_READ_WRITE_TOKEN=""
